local function takeOwnership()
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then
        hrp:SetNetworkOwner(lp)
    end
end

local function antiLagback()
    if not antiLagbackEnabled then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local currentPos = hrp.Position
    local currentVel = hrp.AssemblyLinearVelocity
    if tick() % 5 < 0.1 then takeOwnership() end
    if lastGoodPosition then
        local distMoved = (currentPos - lastGoodPosition).Magnitude
        if distMoved > 100 and currentVel.Magnitude < 10 then
            lagbackDetected = true
            hrp.CFrame = CFrame.new(lastGoodPosition)
            hrp.AssemblyLinearVelocity = lastGoodVelocity or Vector3.zero
        elseif distMoved < 200 then
            lastGoodPosition = currentPos
            lastGoodVelocity = currentVel
            lagbackDetected = false
        end
    else
        lastGoodPosition = currentPos
        lastGoodVelocity = currentVel
    end
    if currentVel.Magnitude > 95 then
        hrp.AssemblyLinearVelocity = currentVel.Unit * 95
    end
end

