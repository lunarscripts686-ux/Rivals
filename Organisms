local function getPromptPart(prompt)
    local p = prompt.Parent
    if p:IsA("BasePart") then return p end
    if p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart") end
    if p:IsA("Attachment") then return p.Parent end
    return p:FindFirstChildWhichIsA("BasePart", true)
end
local function findStealPrompt()
    local hrp = getHRP(); if not hrp then return end
    local nearest, minDist = nil, math.huge
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return end
    for _, desc in pairs(plots:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled and desc.ActionText == "Steal" then
            local part = getPromptPart(desc)
            if part then
                local d = (hrp.Position - part.Position).Magnitude
                if d < minDist then minDist = d; nearest = desc end
            end
        end
    end
    return nearest, minDist
end
local function makePromptsVisible()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return end
    for _, desc in pairs(plots:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.ActionText == "Steal" then
            desc.MaxActivationDistance = 9e9
            desc.RequiresLineOfSight = false
            desc.ClickablePrompt = true
        end
    end
end
local function triggerPrompt(prompt)
    if not prompt or not prompt:IsDescendantOf(workspace) then return end
    prompt.MaxActivationDistance = 9e9
    prompt.RequiresLineOfSight = false
    prompt.ClickablePrompt = true
    local ok = pcall(fireproximityprompt, prompt, 9e9, 0)
    if not ok then
        pcall(function() prompt:InputHoldBegin(); task.wait(0); prompt:InputHoldEnd() end)
    end
end
local function createGrabCircle()
    if grabCircleObj then grabCircleObj:Destroy(); grabCircleObj = nil end
    if not showGrabCircle or not grabEnabled then return end
    local char = lp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local circle = Instance.new("Part")
    circle.Size = Vector3.new(grabRange * 2, 0.2, grabRange * 2)
    circle.Position = hrp.Position
    circle.Anchored = true; circle.CanCollide = false; circle.Transparency = 0.7
    circle.BrickColor = BrickColor.new("Really blue"); circle.Material = Enum.Material.Neon
    circle.Parent = workspace; circle.Name = "GrabRangeCircle"
    grabCircleObj = circle
    coroutine.wrap(function()
        while grabCircleObj and grabEnabled do
            local newHrp = getHRP()
            if newHrp then grabCircleObj.Position = newHrp.Position end
            task.wait(0.1)
        end
    end)()
end
local function startGrab()
    if grabLoop then grabLoop:Disconnect() end
    makePromptsVisible()
    createGrabCircle()
    grabLoop = RunService.Heartbeat:Connect(function()
        if not grabEnabled then return end
        local prompt, dist = findStealPrompt()
        if prompt and dist <= grabRange then triggerPrompt(prompt) end
    end)
end
local function stopGrab()
    if grabLoop then grabLoop:Disconnect(); grabLoop = nil end
    if grabCircleObj then grabCircleObj:Destroy(); grabCircleObj = nil end
end

local function isRagdolled(char)
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return false end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown
        or hum.PlatformStand == true
end
local function fullyRecoverFromRagdoll()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    for i = 1, 3 do
        hum:ChangeState(Enum.HumanoidStateType.Running)
        task.wait(0.03)
    end
    hum.PlatformStand = false
    hum.Sit = false
    hum.AutoRotate = true
    hum.WalkSpeed = DEFAULT_WALKSPEED
    hum.JumpPower = 50
    hum.HipHeight = 0
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("Motor6D") and not v.Enabled then v.Enabled = true end
    end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("Constraint") and (v.Name:lower():find("rag") or v.Name:lower():find("doll")) then
            v:Destroy()
        end
        if v:IsA("BodyVelocity") or v:IsA("BodyPosition") or v:IsA("BodyGyro") then
            v:Destroy()
        end
    end
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Anchored = false
        end
    end
    hrp.Velocity = Vector3.new(0, 8, 0)
    pcall(function()
        local module = lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
        require(module):GetControls():Enable()
    end)
    if workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = hum end
    task.spawn(function()
        task.wait(0.1)
        if hum and hum.Parent then
            hum.WalkSpeed = DEFAULT_WALKSPEED
            hum.JumpPower = 50
        end
    end)
end

local function preventRespawn()
    if not antiRespawnEnabled then return end
    local char = lp.Character
    if not char then
        local newChar = Instance.new("Model"); newChar.Name = "Character"; newChar.Parent = workspace
        local hrp = Instance.new("Part"); hrp.Name = "HumanoidRootPart"; hrp.Anchored = true; hrp.Parent = newChar
        local hum = Instance.new("Humanoid"); hum.Parent = newChar
        lp.Character = newChar
        characterLocked = true
    end
end

local function updateWalking()
    local char = lp.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    local currentVel = root.AssemblyLinearVelocity
    if hoverEnabled then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {char}
        local raycastResult = workspace:Raycast(root.Position, Vector3.new(0, -50, 0), raycastParams)
        if raycastResult then
            local groundY = raycastResult.Position.Y
            local targetY = groundY + hoverHeight
            local currentY = root.Position.Y
            local yDifference = targetY - currentY
            if math.abs(yDifference) > 0.3 then
                root.AssemblyLinearVelocity = Vector3.new(currentVel.X, yDifference * 15, currentVel.Z)
            else
                root.AssemblyLinearVelocity = Vector3.new(currentVel.X, 0, currentVel.Z)
            end
        end
    end
    if gravityEnabled and not hoverEnabled then
        if currentVel.Y < -2 then
            root.AssemblyLinearVelocity = Vector3.new(currentVel.X, currentVel.Y * gravityStrength, currentVel.Z)
        end
        if currentVel.Y < -50 then
            root.AssemblyLinearVelocity = Vector3.new(currentVel.X, -50, currentVel.Z)
        end
    end
    if patrolMode ~= "none" and not lockActive then
        local waypoints = getCurrentWaypoints()
        local targetPos = waypoints[currentWaypoint]
        local currentPos = root.Position
        local targetXZ = Vector3.new(targetPos.X, 0, targetPos.Z)
        local currentXZ = Vector3.new(currentPos.X, 0, currentPos.Z)
        local distanceXZ = (targetXZ - currentXZ).Magnitude
        if distanceXZ > 3 then
            local moveDirection = (targetXZ - currentXZ).Unit
            local currentSpeed = getCurrentSpeed()
            root.AssemblyLinearVelocity = Vector3.new(
                moveDirection.X * currentSpeed,
                root.AssemblyLinearVelocity.Y,
                moveDirection.Z * currentSpeed
            )
        else
            if currentWaypoint == 2 and not waitingAtWaypoint2 then
                waitingAtWaypoint2 = true
                root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                task.spawn(function()
                    task.wait(PAUSE_AT_WAYPOINT_2)
                    if patrolMode ~= "none" and currentWaypoint == 2 then
                        currentWaypoint = 3
                        waitingAtWaypoint2 = false
                    end
                end)
            elseif currentWaypoint == 2 and waitingAtWaypoint2 then
                root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
            elseif currentWaypoint == #waypoints then
                stopMovement()
            else
                currentWaypoint = currentWaypoint + 1
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    local char = lp.Character
    if not char then return end
    local hrp = getHRP()
    local hum = getHumanoid()
    antiLagback()
    updateWalking()
    updateSpeed()
    if autoDodgeEnabled and not isDodging then
        local threat, dist = getNearestThreat()
        if threat and dist <= dodgeRange then performDodge() end
    end
    if lockEnabled and lockTarget then
        updateLock()
    end
    if autoMedusaEnabled then
        local enemy = getNearestEnemy()
        if enemy and enemy.Character then
            if not medusaTriggeredEnemies[enemy] then
                medusaTriggeredEnemies[enemy] = true
                task.spawn(function() task.wait(0.1); activateMedusa(); task.wait(2); medusaTriggeredEnemies[enemy] = false end)
            end
        end
    end
    if autoBatEnabled and not medusaActive then
        local bat = findBat()
        local target = getNearestPlayerForBat()
        if bat and target and target.Character then
            equipBat(bat)
            bat:Activate()
        end
    end
    if char then
        local ragdollNow = isRagdolled(char)
        if ragdollNow and not wasRagdolled and not alreadyTP then
            if tpMode ~= "Off" then
                alreadyTP = true
                task.spawn(function()
                    task.wait(0.15)
                    local c = lp.Character
                    if not c then alreadyTP = false return end
                    for _, v in pairs(c:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.AssemblyLinearVelocity = Vector3.zero
                            v.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                    local dest = (tpMode == "Left") and tpPositionLeft or tpPositionRight
                    c:PivotTo(CFrame.new(dest + Vector3.new(0, 3, 0)))
                    task.wait(1.5)
                    alreadyTP = false
