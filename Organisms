local function isCountdownNumber(text)
    local num = tonumber(text)
    return (num and num >= 1 and num <= 5), num
end
local function isTimerInCountdown(label)
    if not label then return false end
    local ok, num = isCountdownNumber(label.Text)
    return ok and num >= 1 and num <= 5
end

local function performDodge()
    if isDodging then return end
    if tick() - lastDodgeTime < dodgeCooldown then return end
    local hrp = getHRP()
    if not hrp then return end
    isDodging = true
    lastDodgeTime = tick()
    task.spawn(function()
        for i = 1, dodgeJumpCount do
            hrp.Velocity = Vector3.new(hrp.Velocity.X, dodgeJumpForce, hrp.Velocity.Z)
            if i < dodgeJumpCount then task.wait(dodgeJumpDelay) end
        end
        task.wait(0.3)
        isDodging = false
    end)
end
local function getNearestThreat()
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, minDist = nil, dodgeRange
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local targetHRP = char:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    local dist = (hrp.Position - targetHRP.Position).Magnitude
                    if dist < minDist then minDist = dist; nearest = plr end
                end
            end
        end
    end
    return nearest, minDist
end

local function updateLock()
    if not lockEnabled or not lockTarget then
        lockActive = false
        lockTarget = nil
        return
    end
    local char = lp.Character
    if not char then lockActive = false; return end
    local hrp = getHRP()
    if not hrp then return end
    local targetChar = lockTarget.Character
    if not targetChar or targetChar.Humanoid.Health <= 0 then
        lockActive = false; lockTarget = nil; return
    end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHRP then lockActive = false; return end
    local dist = (hrp.Position - targetHRP.Position).Magnitude
    if dist > lockMaxRange then
        lockActive = false; lockTarget = nil; return
    end
    if not lockActive then
        previousPatrolMode = patrolMode
        stopMovement()
        lockActive = true
    end
    local direction = (targetHRP.Position - hrp.Position).Unit
    hrp.AssemblyLinearVelocity = Vector3.new(
        direction.X * lockSpeed,
        hrp.AssemblyLinearVelocity.Y,
        direction.Z * lockSpeed
    )
    if targetHRP.Position.Y > hrp.Position.Y + lockJumpThreshold then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
    end
end

local function unequipBat()
    local char = lp.Character; if not char then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("bat") or tool.Name == "Bat") then
            local backpack = lp:FindFirstChild("Backpack")
            if backpack then tool.Parent = backpack end; break
        end
    end
end
local function unequipMedusa()
    local char = lp.Character; if not char then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("medusa") then
            local backpack = lp:FindFirstChild("Backpack")
            if backpack then tool.Parent = backpack end
            medusaActive = false; break
        end
    end
end
local function findMedusaTool()
    local char = lp.Character; if not char then return nil end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("medusa") then return tool end
    end
    local backpack = lp:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("medusa") then return tool end
        end
    end
    return nil
end
local function getNearestEnemy()
    local hrp = getHRP(); if not hrp then return nil end
    local nearest, minDist = nil, medusaDistance
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            if char then
                local targetHRP = char:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    local dist = (hrp.Position - targetHRP.Position).Magnitude
                    if dist < minDist then minDist = dist; nearest = plr end
                end
            end
        end
    end
    return nearest, minDist
end
local function activateMedusa()
    if not autoMedusaEnabled or medusaActive then return end
    local now = tick()
    if now - lastMedusaUse < medusaCooldown then return end
    local medusaTool = findMedusaTool()
    if medusaTool then
        unequipBat()
        if medusaTool.Parent == lp.Backpack then
            local hum = getHumanoid()
            if hum then hum:EquipTool(medusaTool); medusaActive = true end
        end
        task.wait(0.1)
        medusaTool:Activate()
        lastMedusaUse = now
        task.wait(0.5)
        unequipMedusa()
    end
end

local function findBat()
    if medusaActive then return nil end
    local char = lp.Character; if not char then return nil end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("bat") or tool.Name == "Bat") then return tool end
    end
    local backpack = lp:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("bat") or tool.Name == "Bat") then return tool end
        end
    end
    return nil
end
local function equipBat(bat)
    if not bat or medusaActive then return false end
    if bat.Parent == lp.Character then return true end
    if bat.Parent == lp.Backpack then
        local hum = getHumanoid()
        if hum then hum:EquipTool(bat); return true end
    end
    return false
end
