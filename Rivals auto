-- ðŸ”« AUTO AMMO + HP
-------------------------------------------------
local collectHealth = false
local collectAmmo = false

RunService.RenderStepped:Connect(function()
	if not (collectHealth or collectAmmo) then return end

	local character = player.Character
	if not character then return end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	if not hrp or not humanoid then return end

	local needsHealth = humanoid.Health < humanoid.MaxHealth

	for _, obj in pairs(workspace:GetChildren()) do
		if obj.Name == "_drop" and obj:IsA("BasePart") then
			if (collectHealth and obj:FindFirstChild("Health") and needsHealth)
			or (collectAmmo and obj:FindFirstChild("Ammo")) then
				pcall(function()
					firetouchinterest(hrp, obj, 0)
					firetouchinterest(hrp, obj, 1)
				end)
			end
		end
	end
end)

toggle("Auto Ammo & HP", function(v)
	collectHealth = v
	collectAmmo = v
end)

