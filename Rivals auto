--// TOGGLE FUNCTION
local function toggle(text, callback)
	local b = Instance.new("TextButton", content)
	b.Size = UDim2.fromScale(0.9,0.12)
	b.Text = "[ OFF ] "..text
	b.Font = Enum.Font.Gotham
	b.TextScaled = true
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(35,35,35)
	b.BorderSizePixel = 0

	local on = false
	b.Activated:Connect(function()
		on = not on
		b.Text = (on and "[ ON ] " or "[ OFF ] ")..text
		b.BackgroundColor3 = on and Color3.fromRGB(0,120,255) or Color3.fromRGB(35,35,35)
		callback(on)
	end)
end

